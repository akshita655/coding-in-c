int t[201][20001];
bool subset(int arr[], int n, int sum){
    if(sum == 0){        //if sum = 0 then doesnt matter array is left or not, we have acheived our target
        return true;
    }
    if(n == 0){         // if array is empty but the sum is not computed means the answer is wrong
        return false;
    }
    if(t[n][sum] != -1){   // MEMOIZATION UTILISATION
        return t[n][sum];
    }
    if(sum >= arr[n-1]){
        return t[n][sum] = subset(arr, n-1, sum-arr[n-1]) || subset(arr, n-1, sum);   
    }// from this if condition we are checking that whether we are getting any true value from any branch
    else{
        return t[n][sum] = subset(arr, n-1, sum);
    }
}
bool canPartition(int* nums, int numsSize) {
    int sum = 0;
    for(int i=0;i<numsSize;i++){         //calculating sum 
        sum = sum + nums[i];
    }
    if(sum % 2 != 0){                   //to check wether the array is possible to be distributed
        return false;
    }
    memset(t, -1, sizeof(t));           //initializing the matrix for memoization
    return subset(nums, numsSize, sum / 2);
}
