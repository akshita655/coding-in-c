class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> words(wordDict.begin(), wordDict.end());
        int len = s.size();
        vector<bool> dp(len+1, false);
        dp[0] = true;
        for(int i = 1; i <= len; i++){
            for(int j = 0; j < i; j++){
                if(dp[j] == true){
                    string str = s.substr(j, i-j);
                    if(words.count(str) > 0){
                        dp[i] = true;
                    }
                }
            }
        }
        return dp[len];
    }
};
