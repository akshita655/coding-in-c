class Solution {
public:
    int height(TreeNode *root){
        if(root == NULL){
            return 0;
        }
        int l = height(root -> left);
        int r = height(root -> right);
        return 1 + (l > r ? l : r);
    }
    TreeNode* lcaDeepestLeaves(TreeNode* root) {
        int l = height(root -> left);
        int r = height(root -> right);
        if(l == r){
            return root;
        }
        else if(l > r){
            return lcaDeepestLeaves(root -> left);
        }
        else{
            return lcaDeepestLeaves(root -> right);
        }
    }
};
