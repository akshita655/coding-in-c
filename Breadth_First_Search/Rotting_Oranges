class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        queue<pair<int, int>> q;
        int fresh = 0;
        int rows = grid.size();
        int cols = grid[0].size();
        for(int i=0;i<rows;i++){
            for(int j=0;j<cols;j++){
                if(grid[i][j] == 2){
                    q.push({i, j});
                }
                else if(grid[i][j] == 1){
                    fresh++;
                }
            }
        }
        if(fresh == 0){
            return 0;
        }
        int directions[4][2] = {{1,0},{-1,0},{0,1},{0,-1}};
        int minutes = 0;
        while(!q.empty()){
            int size = q.size();
            bool rottenThisTime = false;
            for(int i=0;i<size;i++){
                pair<int, int> current = q.front();
                q.pop();
                int x = current.first;
                int y = current.second;
                for(int k=0;k<4;k++){
                    int newX = x + directions[k][0];
                    int newY = y + directions[k][1];
                    if(newX >= 0 && newY >= 0 && newX < rows && newY < cols && grid[newX][newY] == 1){
                        grid[newX][newY] = 2;
                        rottenThisTime = true;
                        q.push({newX, newY});
                        fresh--;
                    }
                }
            }
            if(rottenThisTime){
                minutes++;
            }
        }
        if(fresh > 0){
            return -1;
        }
        return minutes;
    }
};

