#define MAX 500
int queue[MAX];
int front = -1;
int rear = -1;
void enqueue(int num){
    if(front == -1 && rear == -1){
        front = 0;
        rear = 0;
        queue[rear] = num;
    }
    else{
        rear = (rear + 1) % MAX;
        queue[rear] = num;
    }
}
int dequeue(){
    int x = queue[front];
    if(front == rear){
        front = rear = -1;
    }
    else{
        front = (front + 1) % MAX;
    }
    return x;
}
int size() {
    if (front == -1)
        return 0;

    if (rear >= front)
        return rear - front + 1;

    return MAX - front + rear + 1;
}
int findTheWinner(int n, int k) {
    front = rear = -1;
    for(int i = 1; i <= n; i++)
        enqueue(i);
    while(size() > 1){
        for(int i = 1;i < k;i++){
            enqueue(dequeue());
        }
        dequeue();
    }
    return queue[front];
}
